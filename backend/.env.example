# Copy to backend/.env and fill in your local MySQL credentials.
# Environment variables override this file. Never commit real secrets.
APP_NAME=PerkFlow

# Read-only group-buy assistant (native Chat Completions tool calls).
# Base URL excludes /chat/completions; API keys stay in local .env only.
LLM_BASE_URL=
# Remote HTTP requires an explicit origin, e.g. ["http://your-campus-gateway"];
# HTTP sends the API key and conversation without transport encryption.
LLM_HTTP_ALLOWED_ORIGINS=[]
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=25
AGENT_TIMEOUT=90
AGENT_MAX_ROUNDS=8
# Provider-specific parameters, e.g. disabling thinking for a compatible non-thinking model.
LLM_EXTRA_BODY={}
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=perkflow
# Local development can use your Navicat account; no new account is auto-created.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=5
MYSQL_CONNECT_TIMEOUT=5
MYSQL_QUERY_TIMEOUT=10
# JSON array of allowed frontend origins; no wildcard credentials.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=2
REDIS_KEY_PREFIX=perkflow:auth:
# Order ID allocation state: String counter without TTL; never reset on failed orders.
ORDER_ID_KEY_PREFIX=perkflow:id:
# Order lock: user ID + voucher ID, UUID owner, Lua release, SET NX EX seconds; no renewal.
ORDER_LOCK_KEY_PREFIX=perkflow:lock:order:
ORDER_LOCK_TTL=30
# Public query cache namespace, independent from authentication keys.
CACHE_KEY_PREFIX=perkflow:cache:
CACHE_LOCK_KEY_PREFIX=perkflow:lock:
# Merchant rebuild lease, maximum lock-wait budget, and retry interval; all in milliseconds.
SHOP_CACHE_LOCK_TTL_MS=15000
SHOP_CACHE_LOCK_WAIT_MS=1000
SHOP_CACHE_LOCK_RETRY_MS=50
SHOP_CACHE_TTL=1800
# Positive cache TTL = base + random integer in [0, jitter], in seconds; 0 disables jitter.
SHOP_CACHE_TTL_JITTER=300
# Short-lived not-found marker; cache hits do not renew this TTL.
SHOP_NULL_CACHE_TTL=120
SHOP_TYPE_CACHE_TTL=1800
SHOP_TYPE_CACHE_TTL_JITTER=300
SESSION_COOKIE_NAME=perkflow_session
# false for localhost HTTP, true when deploying with HTTPS.
SESSION_COOKIE_SECURE=false
ANONYMOUS_SESSION_TTL=600
# Sliding idle timeout, renewed together with the cookie after successful API access.
LOGIN_SESSION_TTL=3600
SMS_CODE_TTL=300
SMS_SEND_INTERVAL=60
SMS_MAX_ATTEMPTS=5
# Current default is async; start the separate worker after upgrading the database.
# sync is for isolated baseline comparisons; do not mix modes on the same activity.
ORDER_MODE=async
# Current default: Redis-only HTTP admission; SQL checkpoints begin in the MQ consumer.
# redis/database preserve earlier stages for isolated study, never mix on one activity.
ORDER_ADMISSION_MODE=redis_first
SECKILL_KEY_PREFIX=perkflow:seckill:
ORDER_WORKER_CONCURRENCY=5
ORDER_RETRY_LIMIT=5
ORDER_DELIVERY_LEASE=30
ORDER_REDELIVERY_SECONDS=60
# RabbitMQ credentials are read from ignored root .env; backend/.env and OS env override it.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_PREFIX=perkflow.seckill
